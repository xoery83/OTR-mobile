{
  "name": "otr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:expo-go": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:dev": "node --env-file-if-exists=.env.backend --import tsx backend/src/server.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db",
    "supabase:validate": "scripts/supabase/validate-local.sh",
    "stage9:synthetic": "tsx scripts/stage9/synthetic-dry-run.ts",
    "stage9:synthetic-http": "vitest run backend/src/stage9RestExtractor.test.ts",
    "stage9:extract:production": "tsx scripts/stage9/extract-production.ts",
    "stage9:transform:private": "tsx scripts/stage9/transform-private.ts",
    "stage9:verify:restore": "tsx scripts/stage9/verify-hosted-restore.ts",
    "stage9:load:hosted-dev": "tsx scripts/stage9/load-hosted-dev.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.0.0",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
