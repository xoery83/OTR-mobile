{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "apple-device-qa": {
      "extends": "preview",
      "env": {
        "OTR_IOS_VARIANT": "production",
        "EXPO_PUBLIC_OTR_SYNC_TRANSPORT": "dev",
        "EXPO_PUBLIC_OTR_API_BASE_URL": "https://api-dev.xoery.art",
        "EXPO_PUBLIC_OTR_DEV_SUPABASE_URL": "https://tuqigdxrvrerfewsxqgm.supabase.co"
      }
    },
    "production": {
      "env": {
        "OTR_IOS_VARIANT": "production"
      },
      "autoIncrement": true
    }
  }
}
