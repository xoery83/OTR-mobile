#!/usr/bin/python3
"""Install and arm only the reviewed C01 DEV window. Run on the designated Linux host."""
import argparse
from contextlib import contextmanager
from datetime import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import time

RUNTIME = Path("/run/otr/root2-c01-keep-v5")
LEDGER = Path("/var/lib/otr/root2-c01-maintenance")
LOCK = Path("/run/lock/otr-universal-finite-service.lock")
JOIN = Path("c01-nov06-b-joined-seal")
DISPATCHER = JOIN / "recovery_service/dispatcher.py"
REQUIRED_FILES = (
    DISPATCHER, JOIN / "keeper_systemd_binding.py",
    Path("c01-nov06-b-image-only-offline/controls.py"),
    Path("c01-nov06-b-release-062a4903/writer_lease_binding_v5.py"),
    Path("mcp-fresh-3586-qualification/static/c02-timers.py"),
)
VERIFY_MODE = "VERIFY_AND_ROLLBACK"
VERIFY_RUNNER = JOIN / "recovery_service/verify_and_rollback.py"
VERIFY_START = JOIN / "recovery_service/verify_start_gate.py"
VERIFY_ACTIONS = frozenset(("host-fence", "pg-fence", "host-reverse", "pg-reverse"))
VERIFY_CREDENTIALS = Path("/run/otr/root2-c01-verify-credentials")
OFFSETS = {"main": 780, "backup": 810, "dispatch": 0}
BUDGETS = {"main": 420, "backup": 390, "dispatch": 770}
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
PYTHON = "/usr/bin/python3"
MARGIN = 120
M1_KIND = "COMBINED_APPROVAL_REQUEST_NO_START_UNLESS_EXECUTION_ENTRY_QUALIFIES"
M1_TARGET = "sha256:9fd700f36c625af47b5885fd3f2797db2903ba16b751af2845f8b13a0cea2125"
M1_SOURCE = "bfa5c0fed3a7e80bb601b4814c984a3f4aa9075f"
M1_ARCHIVE = "2be0b62d10f184d0cf2fad796cb68c7ec50c595a6f99ab0084015ea2c88190ba"
M1_BASELINE = "sha256:127bc6ce0aa16dd7d40eb133e1ec077d14f65ad2f1688fd512c7bbfc992808e9"
M1_MANUAL_RISK = {
    "disposition": "OWNER_ACCEPTED_MANUAL_RELAUNCH_RISK",
    "baselineCID": "@BASELINE_CONTAINER_ID@",
    "ownerDecision": "@M1_MANUAL_RISK_OWNER_DECISION_ID@",
    "paths": ["HOST_ROOT_DOCKER_EXPLICIT_START", "PRIVILEGED_MANUAL_PREPARE_RESUME"],
}
M1_BOUNDED_LEGACY_EFFECTS = {
    "disposition": "ACCEPTED_BOUNDED_LEGACY_EFFECTS",
    "ownerDecision": "@M1_BOUNDED_LEGACY_OWNER_DECISION_ID@",
    "threeHistoricalCallsSHA256": "@M1_BOUNDED_LEGACY_CALLS_SHA256@",
    "twoOriginalPdfKeysSHA256": "@M1_BOUNDED_LEGACY_PDF_KEYS_SHA256@",
    "alreadySubmittedProviderRequests": 3,
    "newProviderCalls": 0,
    "historicalReplay": False,
}
PROJECT = "@DEV_PROJECT_REF@"
sys.dont_write_bytecode = True


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def valid_sha(value):
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value)


def identity(value):
    return [value.st_dev, value.st_ino]


def stable_path(path):
    require(path.is_absolute() and path.resolve() == path, "EXACT_ABSOLUTE_PATH_REQUIRED")
    return path


def private_directory(path):
    stable_path(path)
    info = path.lstat()
    require(stat.S_ISDIR(info.st_mode) and (info.st_uid, info.st_gid) == (0, 0)
            and stat.S_IMODE(info.st_mode) == 0o700, "ROOT_PRIVATE_DIRECTORY_REQUIRED")
    return identity(info)


def private_file(path, modes):
    stable_path(path)
    info = path.lstat()
    require(stat.S_ISREG(info.st_mode) and (info.st_uid, info.st_gid) == (0, 0)
            and info.st_nlink == 1 and stat.S_IMODE(info.st_mode) in modes,
            "ROOT_PRIVATE_REGULAR_FILE_REQUIRED")


def persist_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def create_directory(path, *, fresh=False):
    stable_path(path)
    try:
        path.mkdir(mode=0o700)
        persist_directory(path.parent)
    except FileExistsError:
        require(not fresh, "WINDOW_PATH_ALREADY_EXISTS")
    return private_directory(path)


def exclusive(path, raw, mode=0o400):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb") as file:
        file.write(raw)
        file.flush()
        os.fsync(file.fileno())
    persist_directory(path.parent)


@contextmanager
def writer():
    fd = os.open(stable_path(LOCK), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        current = os.fstat(fd)
        require(stat.S_ISREG(current.st_mode) and current.st_uid == 0
                and current.st_nlink == 1 and stat.S_IMODE(current.st_mode) & 0o022 == 0
                and identity(current) == identity(LOCK.lstat()), "WRITER_IDENTITY_UNCONFIRMED")
        yield identity(current)
    finally:
        os.close(fd)


def pinned(path, expected):
    require(valid_sha(expected), "EXACT_SHA256_REQUIRED")
    raw = stable_path(path).read_bytes()
    require(sha(raw) == expected, "PINNED_FILE_DRIFT")
    return raw


def manifest(raw):
    value = json.loads(raw)
    require(isinstance(value, dict) and set(value) == {"version", "files"}
            and value["version"] == "otr.c01.keep-v5.bundle/1"
            and isinstance(value["files"], dict), "EXACT_MANIFEST_REQUIRED")
    files = value["files"]
    require(all(str(path) in files for path in REQUIRED_FILES), "MANIFEST_ENTRYPOINT_REQUIRED")
    for name, digest in files.items():
        item = Path(name)
        require(not item.is_absolute() and len(item.parts) >= 2 and str(item) == name
                and all(re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", part) for part in item.parts)
                and item.suffix in {".py", ".sql", ".json"} and valid_sha(digest),
                "MANIFEST_FILE_SCOPE_REFUSED")
    return files


def m1_plan(raw, digest):
    require(sha(raw) == digest, "M1_MANIFEST_PIN_DRIFT")
    manifest = json.loads(raw)
    require(manifest["status"] == M1_KIND and manifest["project"] == PROJECT
            and manifest["operator"] == "Root2" and manifest["candidateImage"] == M1_TARGET
            and manifest["source"] == M1_SOURCE and manifest["archiveSHA256"] == M1_ARCHIVE,
            "M1_TARGET_OR_AUTHORITY_DRIFT")
    host, pg, clock = (manifest[key] for key in ("host", "pg", "time"))
    sql, scope = manifest["sql"], manifest["protected"]
    bounded_legacy = scope.get("boundedLegacyEffects")
    require(isinstance(bounded_legacy, dict) and bounded_legacy == M1_BOUNDED_LEGACY_EFFECTS
            and type(bounded_legacy["alreadySubmittedProviderRequests"]) is int
            and type(bounded_legacy["newProviderCalls"]) is int
            and bounded_legacy["historicalReplay"] is False
            and valid_sha(bounded_legacy["threeHistoricalCallsSHA256"])
            and valid_sha(bounded_legacy["twoOriginalPdfKeysSHA256"])
            and re.fullmatch(r"[0-9a-f-]{36}", bounded_legacy["ownerDecision"]),
            "M1_BOUNDED_LEGACY_EFFECTS_SCOPE_DRIFT")
    manual_risk = host.get("manualRelaunchRisk")
    require(manual_risk == M1_MANUAL_RISK and host["baselineCID"] == M1_MANUAL_RISK["baselineCID"],
            "M1_MANUAL_RELAUNCH_RISK_SCOPE_DRIFT")
    require(host["baselineImage"] == M1_BASELINE and valid_sha(host["baselineCID"])
            and host["writerPath"] == str(LOCK)
            and isinstance(host["writerIdentity"], list) and len(host["writerIdentity"]) == 2
            and all(type(part) is int and part > 0 for part in host["writerIdentity"])
            and host["pdfStopOnly"] == "otr-universal-pdf-worker.service"
            and host["candidateContinuousHost"] == {"before": "enabled", "after": "disabled"}
            and host["png"] == "M2_FAILED_BASELINE_DO_NOT_START"
            and re.fullmatch(r"[1-9][0-9]{0,19}", pg.get("systemIdentifier", ""))
            and pg["candidateTransport"] == "existing project-linked Supabase Management CLI"
            and pg["forwardAndInversePrincipal"] == "session_user=current_user=postgres"
            and pg["independentReader"] == "separate linked READ ONLY transaction, session_user=current_user=postgres"
            and type(scope["deletes"]) is int and scope["deletes"] == 0
            and type(scope["providerCalls"]) is int and scope["providerCalls"] == 0
            and scope["historicalReplay"] is False and scope["qa158"] is False
            and type(clock["USD"]) is int and clock["USD"] == 0,
            "M1_SCOPE_DRIFT")
    def epoch(value):
        instant = datetime.fromisoformat(value)
        require(instant.utcoffset() is not None and instant.microsecond == 0, "M1_CLOCK_UNBOUND")
        return int(instant.timestamp())

    start, cutoff, inverse_cutoff, end = (epoch(clock[key]) for key in ("T", "forwardBy", "inverseBy", "hardEnd"))
    require(0 < start < 4102444800 and (cutoff-start, inverse_cutoff-start, end-start) == (480, 900, 1200)
            and set(sql) == {"forward", "inverse"}, "M1_EXACT_WINDOW_REQUIRED")
    forward, inverse = sql["forward"], sql["inverse"]
    for name, spec, deadline in (("forward", forward, cutoff), ("inverse", inverse, inverse_cutoff)):
        require(set(spec) == {"executionId", "frameSHA256", "wireSHA256", "cutoffNZDT"}
                and re.fullmatch(r"[a-f0-9]{32}", spec["executionId"])
                and valid_sha(spec["frameSHA256"]) and valid_sha(spec["wireSHA256"])
                and spec["wireSHA256"] == pg[name + "WireSHA256"]
                and epoch(spec["cutoffNZDT"]) == deadline, "M1_WIRE_PIN_DRIFT")
    require(forward["executionId"] != inverse["executionId"]
            and host["candidateName"] == "otr-c01-candidate-" + forward["executionId"]
            and host["retainedName"] == "otr-c01-retained-" + forward["executionId"],
            "M1_ONE_SHOT_ID_DRIFT")
    return {"project": PROJECT, "manifestSHA256": digest, "targetImage": M1_TARGET,
            "baselineCID": host["baselineCID"], "writerIdentity": host["writerIdentity"],
            "boundedLegacyEffects": bounded_legacy,
            "manualRelaunchRisk": manual_risk, "pgSystemIdentifier": pg["systemIdentifier"],
            "candidateContinuousHost": host["candidateContinuousHost"]["after"],
            "T": start, "cutoff": cutoff, "inverseCutoff": inverse_cutoff, "D": end,
            "stopAdmissionSeconds": 30, "healthReserveSeconds": 60,
            "executionId": forward["executionId"], "inverseExecutionId": inverse["executionId"],
            "effectiveSQLSHA256": forward["frameSHA256"], "effectiveInverseSHA256": inverse["frameSHA256"],
            "wirePins": {spec["executionId"]: {"frameSHA256": spec["frameSHA256"],
                     "wireSHA256": spec["wireSHA256"]} for spec in (forward, inverse)}}


def run_m1_linked(raw, digest, ledger, bind_port, *, write_sql, read_sql,
                  pg_system_identifier, clock=time.time):
    """Run through the foreground Host holder and operator-side linked transport."""
    import closed_driver_v5 as driver
    from dev_commit_ack import CommitAck, render
    from dev_db_binding import LinkedPG, M1_CATALOG_QUERY_SHA256, result_value

    config = m1_plan(raw, digest)
    require(config["T"] <= clock() and clock() + 60 < config["cutoff"],
            "M1_WINDOW_OR_RECOVERY_RESERVE_UNAVAILABLE")
    require(read_sql is not write_sql, "M1_INDEPENDENT_READER_REQUIRED")
    query_path = Path(driver.__file__).with_name("EXACT_FIVE_CATALOG.readonly.sql")
    query = query_path.read_text()
    require(sha(query.encode()) == M1_CATALOG_QUERY_SHA256, "M1_READBACK_QUERY_DRIFT")

    require(pg_system_identifier == config["pgSystemIdentifier"], "M1_DEV_PG_ID_UNBOUND")
    ack = CommitAck(write_sql, config["wirePins"])

    def catalog_observation():
        row = result_value(read_sql(query))
        require(row["sessionUser"] == row["currentUser"] == "postgres"
                and row["readOnly"] is True and row["database"] == "postgres"
                and row["systemIdentifier"] == pg_system_identifier
                and type(row["backendPid"]) is int and row["backendPid"] > 0
                and row["backendPid"] != ack.backend_pid,
                "M1_READBACK_SESSION_NOT_INDEPENDENT")
        return row

    def catalog():
        return catalog_observation()["catalog"]

    pg = LinkedPG(config, read_sql, ack, None, clock)
    pg.catalog_observation = catalog_observation
    port = bind_port(config, pg, catalog)
    require(port.request is config and port.pg is pg and callable(pg.assert_stopped_lease),
            "M1_SAME_WRITER_LINK_REQUIRED")
    port.require_writer_lease(config, ledger)
    if port.has_intent():
        return "EXISTING_INTENT_READ_ONLY_RECONCILIATION"
    before, after = driver.expected_catalog(port.read_catalog())
    for inverse, name, cutoff in ((False, "executionId", "cutoff"),
                                  (True, "inverseExecutionId", "inverseCutoff")):
        execution_id = config[name]
        frame = driver.build_at_cutoff(before, after, config[cutoff], execution_id, inverse)
        require(config["wirePins"][execution_id] == {
            "frameSHA256": sha(frame), "wireSHA256": sha(render(frame, execution_id)),
        }, "M1_FORWARD_OR_INVERSE_WIRE_DRIFT")
    return driver.run_held(port, config, ledger, target=M1_TARGET, m1=True)


def run_m1_foreground(raw, digest, ledger, host_binding, host_binding_sha,
                      *, operator_binding, pg_observation, private_dir):
    """Connect once to the sealed Host entry and bind its exchange to the linked driver."""
    payload = Path(__file__).resolve().parent / "payload" / "c01-nov06-b-release-062a4903"
    require(payload.is_dir(), "M1_OPERATOR_PAYLOAD_REQUIRED")
    sys.path.insert(0, str(payload))
    from m1_foreground import DEV_HOST, ssh_exchange
    from dev_joined_port_v2 import M1JoinedPort

    config = m1_plan(raw, digest)
    authority = json.loads(pinned(host_binding, host_binding_sha))
    lease_id, ledger_identity = authority["leaseId"], authority["ledgerIdentity"]
    require(authority["manifestSHA256"] == digest and authority["executionId"] == config["executionId"]
            and valid_sha(authority["actionsSHA256"])
            and re.fullmatch(r"[a-f0-9]{32}", lease_id) and lease_id != config["executionId"]
            and isinstance(ledger_identity, list) and len(ledger_identity) == 2
            and all(type(part) is int and part > 0 for part in ledger_identity)
            and ledger == LEDGER / config["executionId"]
            and config["T"] <= time.time() and time.time() + 60 < config["cutoff"],
            "M1_FOREGROUND_BINDING_DRIFT")
    config.update(leaseId=lease_id, ledgerIdentity=ledger_identity, ledgerPath=str(ledger),
                  hostBindingSHA256=host_binding_sha)
    operator = json.loads(pinned(operator_binding,
                                "d957d852ce589ae28d89de6507f7752eaf45c208b300dad35ca8bf1237889f35"))
    evidence = json.loads(pinned(pg_observation, json.loads(raw)["evidenceSHA256"]["pg"]))
    system_identifier = evidence["rows"][0]["result"]["systemIdentifier"]

    def fixed_operator_file(key):
        pin = operator[key]
        return pinned(Path(pin["path"]), pin["sha256"])

    cli = Path(operator["cliEntry"])
    fixed_operator_file("cliResolved")
    require(cli.resolve() == Path(operator["cliResolved"]["path"])
            and Path(operator["linkedCwd"]) / "supabase/.temp/project-ref" == Path(operator["linkedProject"]["path"])
            and fixed_operator_file("linkedProject").decode().strip() == PROJECT
            and re.findall(rb"^HOST = '(root@[0-9.]+)'$", fixed_operator_file("hostTransport"), re.M)
                == [DEV_HOST.encode()], "M1_OPERATOR_TRANSPORT_DRIFT")
    folder = stable_path(private_dir)
    mode = folder.stat()
    require(stat.S_ISDIR(mode.st_mode) and mode.st_uid == os.getuid()
            and stat.S_IMODE(mode.st_mode) == 0o700, "M1_OPERATOR_PRIVATE_DIRECTORY_REQUIRED")
    transport = {"__name__": "m1_linked_transport", "__file__": operator["sqlTransport"]["path"]}
    exec(compile(fixed_operator_file("sqlTransport"), transport["__file__"], "exec"), transport)
    write_sql, read_sql = (transport["SqlTransport"](str(cli), operator["linkedCwd"], str(folder))
                           for _ in range(2))

    def bind(request, pg, catalog):
        request.update(leaseId=lease_id, ledgerIdentity=ledger_identity, ledgerPath=str(ledger))
        port = M1JoinedPort(request, exchange, pg, catalog)
        require(port.exchange is exchange and port.catalog is catalog, "M1_FOREGROUND_PORT_DRIFT")
        return port

    with ssh_exchange(config) as exchange:
        return run_m1_linked(raw, digest, ledger, bind, write_sql=write_sql, read_sql=read_sql,
                             pg_system_identifier=system_identifier, clock=time.time)


def plan(raw, execution_id, lock_identity, ledger):
    value = json.loads(raw)
    require(value["version"] in {"otr.c01.keep-v5.service/2", VERIFY_MODE}
            and value["project"] == PROJECT
            and value["executionId"] == execution_id and type(value["T"]) is int
            and 0 < value["T"] < 4102444800
            and value["lock"] == {"path": str(LOCK), "identity": lock_identity}
            and value["ledger"] == {"path": str(ledger), "identity": private_directory(ledger)},
            "EXACT_WINDOW_PLAN_REQUIRED")
    if value["version"] == VERIFY_MODE:
        validate_verification_plan(value)
    return value


def validate_verification_plan(config):
    require(set(config) == {"version", "executionId", "leaseId", "T", "lock", "ledger",
                            "host", "verification", "project"}
            and re.fullmatch(r"[0-9a-f]{32}", config["leaseId"])
            and config["leaseId"] != config["executionId"], "EXACT_VALIDATION_PLAN_REQUIRED")
    v = config["verification"]
    require(set(v) == {"hardEnd", "keeperAt", "pg", "restoredRead"}
            and type(v["keeperAt"]) is int and v["keeperAt"] == config["T"] + 600
            and type(v["hardEnd"]) is int and v["hardEnd"] == config["T"] + 1200,
            "EXACT_VALIDATION_CLOCK_REQUIRED")
    pg = v["pg"]
    require(set(pg) == {"forward", "reverse", "readback", "preimageSHA256", "fenceSHA256"}
            and all(valid_sha(pg[k]) for k in ("preimageSHA256", "fenceSHA256"))
            and pg["preimageSHA256"] != pg["fenceSHA256"], "VALIDATION_PG_PLAN_REQUIRED")
    pins = [pg[k] for k in ("forward", "reverse", "readback")] + [
        v["restoredRead"], config["host"]["owningObserver"],
        config["host"]["owningProbe"]["owningActivityReader"],
    ]
    require(all(set(item) == {"path", "sha256"} and valid_sha(item["sha256"])
                for item in pins) and len({item["path"] for item in pins}) == len(pins),
            "VALIDATION_PROGRAM_PINS_REQUIRED")
    require(valid_sha(config["host"]["owningProbe"]["ordinaryReadSHA256"]),
            "VALIDATION_ACTOR_READ_PIN_REQUIRED")


def verify_programs(config):
    if config["version"] != VERIFY_MODE:
        return
    v = config["verification"]
    programs = [v["pg"][key] for key in ("forward", "reverse", "readback")] + [
        v["restoredRead"], config["host"]["owningObserver"],
        config["host"]["owningProbe"]["owningActivityReader"],
    ]
    for item in programs:
        path = Path(item["path"])
        private_file(path, {0o400})
        pinned(path, item["sha256"])


def credentials(config):
    reader = Path(config["pgReadback"]["credentialSourceFile"])
    writer_file = Path(config["sql"]["forwardPassFile"])
    require(reader != writer_file, "INDEPENDENT_PG_READER_CREDENTIAL_REQUIRED")
    for file in (reader, writer_file):
        private_file(file, {0o400, 0o600})
        require(re.fullmatch(r"/[A-Za-z0-9_./-]+", str(file)) is not None,
                "CREDENTIAL_PATH_REFUSED")
    return reader, writer_file


def unit_name(role):
    return "otr-c01-keep-v5-" + role


def offsets(config):
    return {"dispatch": 0, "keeper": 600} if config["version"] == VERIFY_MODE else OFFSETS


def unit_budget(role, config):
    return 540 if config["version"] == VERIFY_MODE else BUDGETS[role]


def unit_argv(role, runtime, plan_path, plan_sha, config):
    require(role in offsets(config), "EXACT_WINDOW_ROLE_REQUIRED")
    if config["version"] == VERIFY_MODE:
        manifest_path = runtime / "manifest.json"
        files = manifest(manifest_path.read_bytes())
        return [PYTHON, "-B", str(runtime / "payload" / VERIFY_START), role,
                config["executionId"], plan_sha, files[str(VERIFY_RUNNER)]]
    return [PYTHON, "-B", str(runtime / "payload" / DISPATCHER), role,
            "--plan", str(plan_path), "--sha256", plan_sha]


def call(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=6,
                            env={"PATH": "/usr/bin:/bin", "LC_ALL": "C", "TZ": "UTC"})
    require(result.returncode == 0, "SYSTEMD_COMMAND_REFUSED")
    return result.stdout.strip()


def show(unit, prop):
    return call(SYSTEMCTL, "show", unit, "--property=" + prop, "--value")


def timeout_usec(unit):
    duration = show(unit, "TimeoutStartUSec")
    scales = {"h": 3600, "min": 60, "s": 1}
    fields = re.findall(r"([0-9]+)(h|min|s)", duration)
    require(fields and " ".join(amount + suffix for amount, suffix in fields) == duration,
            "SYSTEMD_TIMEOUT_UNCONFIRMED")
    return sum(int(amount) * scales[suffix] for amount, suffix in fields) * 1_000_000


def timer_helpers(payload):
    sys.path.insert(0, str(payload / JOIN))
    sys.path.insert(0, str(payload / "c01-nov06-b-image-only-offline"))
    from keeper_systemd_binding import verify_systemd_keeper
    from controls import timer_tools
    return verify_systemd_keeper, timer_tools


def verify_installed(runtime, manifest_sha):
    private_directory(runtime)
    manifest_path = runtime / "manifest.json"
    private_file(manifest_path, {0o400})
    files = manifest(pinned(manifest_path, manifest_sha))
    payload = runtime / "payload"
    entries = list(payload.rglob("*"))
    require(not any(item.is_symlink() for item in entries), "INSTALLED_FILE_SET_DRIFT")
    actual = {str(item.relative_to(payload)) for item in entries if not item.is_dir()}
    directories = {str(item.relative_to(payload)) for item in entries if item.is_dir()}
    expected = {str(parent) for name in files for parent in Path(name).parents if parent != Path(".")}
    require(actual == set(files) and directories == expected, "INSTALLED_FILE_SET_DRIFT")
    for name, digest in files.items():
        path = payload / name
        for directory in path.parents:
            private_directory(directory)
            if directory == payload:
                break
        private_file(path, {0o400})
        pinned(path, digest)
    return files


def verify_mode_files(config, files):
    if config["version"] == VERIFY_MODE:
        require(all(str(name) in files for name in (VERIFY_START, VERIFY_RUNNER)),
                "VALIDATION_ENTRYPOINT_REQUIRED")


def install(args, runtime, ledger, lock_identity):
    config_raw = pinned(args.plan, args.plan_sha256)
    config = plan(config_raw, args.execution_id, lock_identity, ledger)
    verify_programs(config)
    credential_bindings(config)
    require(not any(ledger.iterdir()), "EXCLUSIVE_LEDGER_REQUIRED")
    package = stable_path(args.bundle)
    manifest_raw = pinned(package / "manifest.json", args.manifest_sha256)
    files = manifest(manifest_raw)
    verify_mode_files(config, files)
    for name, digest in files.items():
        pinned(package / "payload" / name, digest)
    # Refuse a different pre-existing execution, including a partial install.
    create_directory(RUNTIME)
    create_directory(runtime, fresh=True)
    payload = runtime / "payload"
    create_directory(payload, fresh=True)
    exclusive(runtime / "manifest.json", manifest_raw)
    for name, digest in files.items():
        target = payload / name
        for directory in reversed(target.parents):
            if directory != payload and payload in directory.parents:
                create_directory(directory)
        exclusive(target, pinned(package / "payload" / name, digest))
    exclusive(ledger / "plan.json", config_raw)
    verify_installed(runtime, args.manifest_sha256)
    return "INSTALLED_INACTIVE"


def clock_bound(config):
    require(time.time() + MARGIN <= config["T"] <= time.time() + 600,
            "EXACT_ARM_MARGIN_UNAVAILABLE")
    require(show("systemd-timesyncd.service", "LoadState") != "error",
            "SYSTEMD_READBACK_UNAVAILABLE")
    require(call("/usr/bin/timedatectl", "show", "--property=NTPSynchronized", "--value") == "yes",
            "HOST_CLOCK_UNCONFIRMED")


def credential_bindings(config):
    if config["version"] == VERIFY_MODE:
        directory = VERIFY_CREDENTIALS / config["executionId"]
        private_directory(directory)
        values = {key: directory / (key + ".pgpass") for key in ("reader", "forward", "reverse")}
        identities = []
        for path in values.values():
            private_file(path, {0o400, 0o600})
            identities.append(identity(path.lstat()))
        require(len({tuple(item) for item in identities}) == 3, "VALIDATION_CREDENTIALS_NOT_DISTINCT")
        return values
    reader, forward = credentials(config)
    return {"reader": reader, "forward": forward}


def service_credentials(role, bindings, config):
    reader = str(bindings["reader"])
    forward = str(bindings["forward"])
    values = [["c01-pg-reader.pgpass", reader]]
    if config["version"] == VERIFY_MODE:
        values.append(["c01-pg-reverse.pgpass", str(bindings["reverse"])])
        if role == "dispatch":
            values.append(["c01-pg-forward.pgpass", forward])
        return sorted(values), sorted(str(path) for path in bindings.values())
    if role == "dispatch":
        values.append(["c01-pg-writer.pgpass", forward])
    return sorted(values), [forward] if role != "dispatch" else []


def read_service_credentials(service):
    unit_path = "/org/freedesktop/systemd1/unit/" + re.sub(
        r"[^A-Za-z0-9]", lambda ch: "_" + format(ord(ch[0]), "02x"), service)
    value = json.loads(call("/usr/bin/busctl", "--json=short", "get-property",
                            "org.freedesktop.systemd1", unit_path,
                            "org.freedesktop.systemd1.Service", "LoadCredential"))
    require(value["type"] == "a(ss)", "SYSTEMD_CREDENTIAL_READBACK_MISMATCH")
    return sorted(value["data"])


def verify_units(runtime, plan_path, args, config):
    bindings = credential_bindings(config)
    verify, _ = timer_helpers(runtime / "payload")
    for role, offset in offsets(config).items():
        unit = unit_name(role)
        service, timer = unit + ".service", unit + ".timer"
        argv = unit_argv(role, runtime, plan_path, args.plan_sha256, config)
        expected_credentials, inaccessible = service_credentials(role, bindings, config)
        if inaccessible:
            require(sorted(shlex.split(show(service, "InaccessiblePaths"))) == inaccessible,
                    "SYSTEMD_CREDENTIAL_SOURCE_VISIBILITY")
        require(read_service_credentials(service) == expected_credentials,
                "SYSTEMD_CREDENTIAL_READBACK_MISMATCH")
        require(verify(show, timeout_usec, unit, (config["T"] + offset) * 1000,
                       argv, unit_budget(role, config))
                and show(service, "Type") == "oneshot"
                and show(service, "KillMode") == "control-group"
                and show(service, "NoNewPrivileges") == "yes"
                and show(service, "TimeoutStopUSec") == "1s"
                and show(timer, "AccuracyUSec") == "1us"
                and show(timer, "Persistent") == "no"
                and show(timer, "RemainAfterElapse") == "no",
                "SYSTEMD_UNIT_READBACK_MISMATCH")


def arm(args, runtime, ledger, config):
    clock_bound(config)
    plan_path = ledger / "plan.json"
    verify_programs(config)
    bindings = credential_bindings(config)
    require({x.name for x in ledger.iterdir()} == {"plan.json"}, "WINDOW_ARM_OR_ACTION_ALREADY_RECORDED")
    for role in {*OFFSETS, "keeper"}:
        for suffix in (".service", ".timer"):
            require(show(unit_name(role) + suffix, "LoadState") == "not-found",
                    "C01_UNIT_ALREADY_PRESENT")
    _, tools = timer_helpers(runtime / "payload")
    registration = json.dumps(
        {"manifestSHA256": args.manifest_sha256, "planSHA256": args.plan_sha256,
         "T": config["T"]}, sort_keys=True).encode()
    exclusive(ledger / "arm.json", registration, 0o600)
    attempted = []
    try:
        for role, offset in offsets(config).items():
            unit = unit_name(role)
            loads, inaccessible = service_credentials(role, bindings, config)
            properties = ["LoadCredential=" + ":".join(item) for item in loads]
            if inaccessible:
                properties.append("InaccessiblePaths=" + " ".join(inaccessible))
            attempted.append(unit)
            call(SYSTEMD_RUN, "--quiet", "--unit=" + unit,
                 "--on-calendar=" + tools.calendar((config["T"] + offset) * 1000),
                 "--timer-property=AccuracySec=1us", "--timer-property=Persistent=no",
                 "--timer-property=RemainAfterElapse=no", "--timer-property=RandomizedDelaySec=0",
                 "--property=Type=oneshot", "--property=User=root", "--property=Group=root",
                 "--property=UMask=0077", "--property=Restart=no", "--property=KillMode=control-group",
                 "--property=NoNewPrivileges=yes", "--property=PrivateTmp=yes",
                 "--property=ProtectHome=yes", "--property=TimeoutStopSec=1s",
                 "--property=TimeoutStartSec=" + str(unit_budget(role, config)) + "s",
                 *["--property=" + prop for prop in properties],
                 *unit_argv(role, runtime, plan_path, args.plan_sha256, config))
        require(time.time() + 10 < config["T"], "DISPATCH_VERIFICATION_MARGIN_UNAVAILABLE")
        verify_units(runtime, plan_path, args, config)
        require(time.time() + 5 < config["T"], "DISPATCH_VERIFICATION_MARGIN_UNAVAILABLE")
        exclusive(ledger / "arm-verified.json", registration, 0o600)
    except (AssertionError, KeyError, OSError, TypeError, ValueError, subprocess.SubprocessError):
        if time.time() + 8 < config["T"] and attempted:
            timers = [u + ".timer" for u in reversed(attempted)
                      if show(u + ".timer", "LoadState") != "not-found"]
            if timers:
                call(SYSTEMCTL, "stop", *timers)
        raise
    return "TRANSIENT_UNITS_ARMED_AND_VERIFIED"


def verify_arm_record(args, ledger):
    arm_record = ledger / "arm.json"
    private_file(arm_record, {0o600})
    record = json.loads(arm_record.read_bytes())
    require(record["manifestSHA256"] == args.manifest_sha256
            and record["planSHA256"] == args.plan_sha256, "ARM_BINDING_DRIFT")


def bound_inactive_units(args, runtime, ledger, config):
    timers, services = [], []
    for role in offsets(config):
        service, timer = unit_name(role) + ".service", unit_name(role) + ".timer"
        require(show(service, "ActiveState") in {"inactive", "failed"},
                "ACTIVE_EXECUTOR_RETAIN_RECOVERY")
        loaded = show(service, "LoadState") != "not-found"
        if show(timer, "LoadState") != "not-found":
            require(loaded and show(timer, "Unit") == service, "UNBOUND_TIMER_RETAIN_RECOVERY")
            timers.append(timer)
        if loaded:
            installed = re.findall(r"argv\[\]=([^;]+);", show(service, "ExecStart"))
            expected = unit_argv(role, runtime, ledger / "plan.json", args.plan_sha256, config)
            require(len(installed) == 1 and shlex.split(installed[0]) == expected,
                    "UNBOUND_EXECUTOR_RETAIN_RECOVERY")
            services.append(service)
    return timers, services


def remove_runtime(args, runtime, ledger, files, config):
    timers, services = bound_inactive_units(args, runtime, ledger, config)
    if (ledger / "arm.json").exists():
        verify_arm_record(args, ledger)
        if timers:
            call(SYSTEMCTL, "stop", *timers)
        for service in services:
            # A transient inactive service may be unloaded as soon as its timer stops.
            if show(service, "ActiveState") == "failed":
                call(SYSTEMCTL, "reset-failed", service)
        require(all(show(unit, "ActiveState") == "inactive" for unit in timers + services),
                "SYSTEMD_RETIREMENT_UNCONFIRMED")
    else:
        require(not timers and not services, "UNBOUND_TIMER_RETAIN_RECOVERY")
    payload = runtime / "payload"
    for name in files:
        (payload / name).unlink()
    for directory in sorted((d for d in payload.rglob("*") if d.is_dir()),
                            key=lambda path: len(path.parts), reverse=True):
        directory.rmdir()
    payload.rmdir()
    (runtime / "manifest.json").unlink()
    runtime.rmdir()
    persist_directory(RUNTIME)


def revoke(args, runtime, ledger, files, config):
    require({x.name for x in ledger.iterdir()} <= {"plan.json", "arm.json", "arm-verified.json"},
            "ACTION_EVIDENCE_PRESENT_RETAIN_RECOVERY")
    remove_runtime(args, runtime, ledger, files, config)
    exclusive(ledger / "runtime-revoked.json", json.dumps(
        {"executionId": args.execution_id, "planSHA256": args.plan_sha256},
        sort_keys=True).encode(), 0o600)
    return "REVOKED_BEFORE_ACTION_LEDGER_RETAINED"


def verify_terminal(args, ledger, config):
    terminal = ledger / "release-terminal.receipt"
    ingress = ledger / "open-ingress.receipt"
    for receipt in (terminal, ingress):
        private_file(receipt, {0o600})
    value = json.loads(pinned(terminal, args.terminal_receipt_sha256))
    open_receipt = json.loads(ingress.read_bytes())
    binding = {"executionId": args.execution_id, "leaseId": config["leaseId"],
               "planSHA256": args.plan_sha256}
    stamp = value.get("observedAt")
    open_stamp = open_receipt.get("observedAt")
    expected_action = sha(json.dumps([args.plan_sha256, "open-ingress"], separators=(",", ":")).encode())
    proof = {key: config["host"]["aperture"][key]
             for key in ("scopedSHA256", "nftSHA256", "legacyPGFenceSHA256")}
    require(set(value) == {*binding, "status", "observedAt", "routeVerified", "preservationVerified", "cutover"}
            and value["cutover"] == proof
            and value["status"] in {"RELEASE_PASS", "RELEASE_RECOVERY",
                                    "RELEASE_ABORTED_BASELINE_INGRESS_RESTORED"}
            and value["routeVerified"] is True and value["preservationVerified"] is True
            and all(value[k] == wanted and open_receipt.get(k) == wanted
                    for k, wanted in binding.items())
            and open_receipt.get("action") == "open-ingress"
            and open_receipt.get("actionSHA256") == expected_action
            and open_receipt.get("evidence") == {"status": value["status"], "cutover": proof}
            and type(open_stamp) is int and type(stamp) is int
            and config["T"] <= open_stamp <= stamp <= config["T"] + 1200
            and stamp <= time.time(), "TERMINAL_RELEASE_EVIDENCE_UNPROVED")
    return value["status"]


def verify_validation_terminal(args, ledger, config):
    binding = {"executionId": args.execution_id, "leaseId": config["leaseId"],
               "planSHA256": args.plan_sha256}
    terminal_path = ledger / "verify-terminal.json"
    private_file(terminal_path, {0o600})
    terminal = json.loads(pinned(terminal_path, args.terminal_receipt_sha256))
    require(set(terminal) == {*binding, "status"}
            and all(terminal[k] == value for k, value in binding.items())
            and terminal["status"] in {"VERIFIED_AND_RESTORED", "RESTORED_PROOF_INCOMPLETE"},
            "VALIDATION_TERMINAL_UNPROVED")
    complete = {}
    for name in ledger.iterdir():
        if name.suffix in {".intent", ".receipt"}:
            require(name.stem in VERIFY_ACTIONS, "VALIDATION_FOREIGN_ACTION")
    for action in VERIFY_ACTIONS:
        intent = ledger / (action + ".intent")
        receipt = ledger / (action + ".receipt")
        if not intent.exists() and not receipt.exists():
            continue
        for path in (intent, receipt):
            private_file(path, {0o600})
        digest = sha(json.dumps([args.plan_sha256, VERIFY_MODE, action], separators=(",", ":")).encode())
        value = json.loads(receipt.read_bytes())
        require(intent.read_bytes() == (digest + "\n").encode()
                and set(value) == {*binding, "action", "actionSHA256", "observedAt", "evidence"}
                and all(value[k] == expected for k, expected in binding.items())
                and value["action"] == action and value["actionSHA256"] == digest
                and value["evidence"] == {} and type(value["observedAt"]) is int
                and config["T"] <= value["observedAt"] <= min(config["verification"]["hardEnd"], time.time()),
                "VALIDATION_ACTION_RECEIPT_UNPROVED")
        complete[action] = value["observedAt"]
    sequence = ["host-fence", "pg-fence", "host-reverse", "pg-reverse"]
    if set(complete) == {"host-fence", "host-reverse"}:
        sequence = ["host-fence", "host-reverse"]
    require(set(complete) == set(sequence)
            and [complete[k] for k in sequence] == sorted(complete.values()),
            "VALIDATION_REVERSE_UNPROVED")
    result_path = ledger / "verify-result.json"
    passed = False
    if result_path.exists():
        private_file(result_path, {0o600})
        result = json.loads(result_path.read_bytes())
        require(set(result) == {*binding, "runtimeProofPassed"}
                and all(result[k] == value for k, value in binding.items())
                and type(result["runtimeProofPassed"]) is bool, "VALIDATION_RESULT_DRIFT")
        passed = result["runtimeProofPassed"]
    require((terminal["status"] == "VERIFIED_AND_RESTORED") == passed
            and (not passed or set(complete) == VERIFY_ACTIONS), "VALIDATION_RESULT_DRIFT")
    return terminal["status"]


def retire(args, runtime, ledger, files, config):
    verify = verify_validation_terminal if config["version"] == VERIFY_MODE else verify_terminal
    status = verify(args, ledger, config)
    verify_arm_record(args, ledger)
    remove_runtime(args, runtime, ledger, files, config)
    exclusive(ledger / "runtime-retired.json", json.dumps(
        {"releaseStatus": status, "planSHA256": args.plan_sha256,
         "releaseReceiptSHA256": args.terminal_receipt_sha256}, sort_keys=True).encode(), 0o600)
    return "TERMINAL_RUNTIME_RETIRED_LEDGER_RETAINED"


def refuse_prior_windows(root, execution_id):
    """Called under the existing Writer before enrolling or arming C01."""
    try:
        private_directory(root)
    except FileNotFoundError:
        return
    for ledger in sorted(root.iterdir()):
        if ledger.name == execution_id:
            continue
        require(re.fullmatch(r"[0-9a-f]{32}", ledger.name), "C01_PRIOR_LEDGER_UNRECOGNIZED")
        private_directory(ledger)
        files = {item.name for item in ledger.iterdir()}
        if files <= {"plan.json"}:
            if files:
                private_file(ledger / "plan.json", {0o400})
            continue
        if files <= {"plan.json", "arm.json", "arm-verified.json", "runtime-revoked.json"} and "runtime-revoked.json" in files:
            plan_path = ledger / "plan.json"
            marker_path = ledger / "runtime-revoked.json"
            private_file(plan_path, {0o400})
            private_file(marker_path, {0o600})
            marker = json.loads(marker_path.read_bytes())
            require(marker == {"executionId": ledger.name, "planSHA256": sha(plan_path.read_bytes())},
                    "C01_PRIOR_REVOKE_BINDING_DRIFT")
            continue
        require(all(name.removesuffix(".intent") + ".receipt" in files
                    for name in files if name.endswith(".intent")), "C01_PRIOR_WINDOW_RECONCILE_ONLY")
        require("runtime-retired.json" in files and "plan.json" in files,
                "C01_PRIOR_WINDOW_RECONCILE_ONLY")
        plan_path = ledger / "plan.json"
        marker_path = ledger / "runtime-retired.json"
        private_file(plan_path, {0o400})
        private_file(marker_path, {0o600})
        plan_bytes = plan_path.read_bytes()
        plan_sha = sha(plan_bytes)
        prior = json.loads(plan_bytes)
        marker = json.loads(marker_path.read_bytes())
        require(prior["executionId"] == ledger.name and marker["planSHA256"] == plan_sha,
                "C01_PRIOR_RETIREMENT_BINDING_DRIFT")
        validation = prior.get("version") == "VERIFY_AND_ROLLBACK"
        terminal = ledger / ("verify-terminal.json" if validation else "release-terminal.receipt")
        private_file(terminal, {0o600})
        payload = terminal.read_bytes()
        result = json.loads(payload)
        allowed = ({"VERIFIED_AND_RESTORED", "RESTORED_PROOF_INCOMPLETE"} if validation else
                   {"RELEASE_PASS", "RELEASE_RECOVERY", "RELEASE_ABORTED_BASELINE_INGRESS_RESTORED"})
        require(result.get("executionId") == ledger.name and result.get("planSHA256") == plan_sha
                and result.get("leaseId") == prior["leaseId"]
                and result.get("status") in allowed and marker.get("releaseStatus") == result["status"]
                and marker.get("releaseReceiptSHA256") == sha(payload),
                "C01_PRIOR_RETIREMENT_BINDING_DRIFT")


def run(args):
    if args.mode == "m1-run":
        raw = pinned(args.plan, args.plan_sha256)
        config = m1_plan(raw, args.plan_sha256)
        require(config["executionId"] == args.execution_id, "M1_ONE_SHOT_ID_DRIFT")
        return {"status": run_m1_foreground(
            raw, args.plan_sha256, LEDGER / args.execution_id, args.host_binding, args.host_binding_sha256,
            operator_binding=args.operator_binding, pg_observation=args.pg_observation,
            private_dir=args.private_dir)}
    if args.mode == "m1-check":
        config = m1_plan(pinned(args.plan, args.plan_sha256), args.plan_sha256)
        require(config["executionId"] == args.execution_id, "M1_ONE_SHOT_ID_DRIFT")
        return {"status": "M1_LINKED_PLAN_VALIDATED", "executionId": config["executionId"]}
    require(sys.platform == "linux" and os.geteuid() == 0 and
            Path("/proc/1/comm").read_text().strip() == "systemd", "ROOT_SYSTEMD_HOST_REQUIRED")
    require(re.fullmatch(r"[0-9a-f]{32}", args.execution_id), "EXACT_EXECUTION_ID_REQUIRED")
    runtime, ledger = RUNTIME / args.execution_id, LEDGER / args.execution_id
    with writer() as lock_identity:
        if args.mode in {"enroll", "arm"}:
            refuse_prior_windows(LEDGER, args.execution_id)
        if args.mode == "enroll":
            create_directory(LEDGER)
            ledger_identity = create_directory(ledger, fresh=True)
            return {"status": "EMPTY_LEDGER_ENROLLED", "executionId": args.execution_id,
                    "lock": {"path": str(LOCK), "identity": lock_identity},
                    "ledger": {"path": str(ledger), "identity": ledger_identity}}
        if args.mode == "install":
            require(args.bundle is not None and args.plan is not None, "BUNDLE_AND_PLAN_REQUIRED")
            return {"status": install(args, runtime, ledger, lock_identity)}
        files = verify_installed(runtime, args.manifest_sha256)
        plan_path = ledger / "plan.json"
        private_file(plan_path, {0o400})
        config = plan(pinned(plan_path, args.plan_sha256), args.execution_id, lock_identity, ledger)
        verify_mode_files(config, files)
        if args.mode == "revoke":
            return {"status": revoke(args, runtime, ledger, files, config)}
        if args.mode == "retire":
            return {"status": retire(args, runtime, ledger, files, config)}
        if args.mode == "arm":
            return {"status": arm(args, runtime, ledger, config)}
        verify_programs(config)
        credential_bindings(config)
        if args.armed:
            verify_units(runtime, plan_path, args, config)
        return {"status": "EXACT_INSTALL_VERIFIED", "files": len(files)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("enroll", "install", "check", "arm", "revoke", "retire", "m1-check", "m1-run"))
    parser.add_argument("--execution-id", required=True)
    parser.add_argument("--bundle", type=Path)
    parser.add_argument("--manifest-sha256")
    parser.add_argument("--plan", type=Path)
    parser.add_argument("--plan-sha256")
    parser.add_argument("--terminal-receipt-sha256")
    parser.add_argument("--armed", action="store_true")
    parser.add_argument("--host-binding", type=Path)
    parser.add_argument("--host-binding-sha256")
    parser.add_argument("--operator-binding", type=Path)
    parser.add_argument("--pg-observation", type=Path)
    parser.add_argument("--private-dir", type=Path)
    os.umask(0o077)
    try:
        print(json.dumps(run(parser.parse_args()), sort_keys=True))
    except (AssertionError, OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        reason = str(error) if type(error) is ValueError and re.fullmatch(r"[A-Z0-9_]+", str(error)) else type(error).__name__
        print(json.dumps({"status": "REFUSED", "reason": reason}), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
