"""Exact linked PG transport boundary for the closed C01 driver."""
import hashlib
import json
import re
import time

PROJECT='@DEV_PROJECT_REF@'
M1_CATALOG_QUERY_SHA256 = '81bc86105718649576dbe7da3c274197421459fbb727765fa4cd2711c090e570'


def evidence_sha(value):
    raw = json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()
    return hashlib.sha256(raw).hexdigest()

DRAIN_SQL="""BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL statement_timeout='5s';
SET LOCAL lock_timeout='1s';
SET LOCAL transaction_timeout='8s';
SELECT jsonb_build_object(
 'sessionUser',session_user,'currentUser',current_user,
 'pgVersion',current_setting('server_version_num')::integer,
 'clock',extract(epoch FROM clock_timestamp()),
 'fullVisibility',pg_has_role(current_user,'pg_read_all_stats','USAGE'),
 'otherOpenClientTransactions',(SELECT count(*) FROM pg_stat_activity
 WHERE datname=current_database() AND backend_type='client backend' AND pid<>pg_backend_pid()
 AND (state IS NULL OR xact_start IS NOT NULL)),
 'writerAdvisoryEntries',(SELECT count(*) FROM pg_locks WHERE locktype='advisory'
 AND database=(SELECT oid FROM pg_database WHERE datname=current_database())
 AND classid=714024 AND objid=2 AND objsubid=2),
 'preparedTransactions',(SELECT count(*) FROM pg_prepared_xacts WHERE database=current_database()),
 'sourceScopes',(SELECT count(*) FROM public.trip_source_universal_scope),
 'providerScopes',(SELECT count(*) FROM public.universal_import_provider_scope)
) AS result;
ROLLBACK;
"""

# Exact retained PDF scope accepted by Owner. Any identity drift loses the exemption.
M1_PDF_SQL = """BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL statement_timeout='5s';
SET LOCAL lock_timeout='1s';
SET LOCAL transaction_timeout='8s';
SET LOCAL search_path=pg_catalog;
SET LOCAL row_security=off;
WITH accepted AS (
 SELECT * FROM jsonb_to_recordset($m1_pdf$@M1_PDF_ACCEPTED_DISPATCHES@$m1_pdf$::jsonb)
 AS x(operation_id uuid,attempt_id uuid,trip_id uuid,source_id uuid,representation_id uuid,
      operation_sha256 text,object_key text)
), dispatch AS (
 SELECT a.*, EXISTS(
  SELECT 1 FROM accepted x JOIN public.trip_source_operations o ON o.id=x.operation_id
  JOIN public.trip_source_representations r ON r.id=x.representation_id
  WHERE a.id=x.attempt_id AND a.operation_id=o.id AND a.canonical_generation=1
   AND a.trip_id=x.trip_id AND a.source_id=x.source_id AND a.representation_id=x.representation_id
   AND o.attempt_id=a.id AND o.attempt_generation=1 AND o.trip_id=x.trip_id
   AND o.source_id=x.source_id AND o.representation_id=x.representation_id
   AND o.operation_sha256=x.operation_sha256 AND o.command='UPLOAD_ORIGINAL'
   AND r.source_id=x.source_id AND r.role='ORIGINAL' AND r.storage_provider='supabase_storage'
   AND r.storage_bucket='trip-source-material' AND r.object_key=x.object_key
   AND a.pdf_binding->>'operationId'=o.id::text AND a.pdf_binding->>'attemptId'=a.id::text
   AND a.pdf_binding->>'operationSha256'=x.operation_sha256
   AND a.pdf_binding->>'tripId'=x.trip_id::text AND a.pdf_binding->>'sourceId'=x.source_id::text
   AND a.pdf_binding->>'representationId'=x.representation_id::text
   AND a.pdf_binding->>'provider'='supabase_storage'
   AND a.pdf_binding->>'bucket'='trip-source-material' AND a.pdf_binding->>'objectKey'=x.object_key
 ) AS exempt
 FROM public.trip_source_execution_attempts a WHERE a.pdf_dispatch_id IS NOT NULL
), gate(sig,sha) AS (VALUES
 ('public.trip_source_pdf_upload_v4_execute(uuid,uuid,bigint,text,jsonb)','136deaf8591e2418a292a29b08450d9c5cad046396dcf6b5b6c1b62490a254c2'),
 ('public.trip_source_pdf_upload_v4_recover_dispatch(uuid,uuid,bigint)','259738dafe9a2b6a010754d18a76a6dd0d1bf3edcde3fd718928009282325ead'),
 ('public.trip_source_pdf_upload_v4_gate()','01d3321387ce574665671646220fe0d5fabe55509c1db47e637203633c539ffa'),
 ('public.trip_source_pdf_upload_v4_scope()','3433f56de655aa15c9fe8b3ab03599d3bda94e27ed36118cd9a1c83eb5e9f85c'),
 ('public.trip_source_universal_pdf_source_scope(uuid,uuid,uuid)','aad7488033b6e120bb5a7181509a425233ba36368a690815ea91ecb5d571f4a3'),
 ('public.trip_sustained_universal_pdf_allowed(uuid,uuid)','ecaa1945ca2b650e5975ae94abdb3cde56f1fec5421a89f49845ff6b8c6964d0')
)
SELECT jsonb_build_object(
 'sessionUser',session_user,'currentUser',current_user,'database',current_database(),
 'readOnly',current_setting('transaction_read_only')='on',
 'systemIdentifier',(pg_control_system()).system_identifier::text,'backendPid',pg_backend_pid(),
 'clock',extract(epoch FROM clock_timestamp()),
 'admissionClosed',(
   (SELECT count(*)=1 AND bool_and(NOT enabled AND NOT beta_enabled AND NOT causal_enabled AND NOT v4_enabled) FROM public.trip_source_pdf_upload_config)
   AND clock_timestamp()>='2026-11-01T08:48:56Z'::timestamptz
   AND (SELECT bool_and(COALESCE(encode(sha256(convert_to(pg_get_functiondef(to_regprocedure(sig)),'UTF8')),'hex')=sha,false)) FROM gate)
 ),
 'unresolvedNonExempt',(SELECT count(*) FROM dispatch a WHERE NOT exempt AND NOT COALESCE(
   (a.phase='TERMINAL' AND a.termination_outstanding=false
    AND a.pdf_terminal_body->>'dispatchId'=a.pdf_dispatch_id::text
    AND a.pdf_terminal_body->'binding'=a.pdf_binding
    AND a.pdf_terminal_body->>'disposition'='WRITER_TERMINAL')
   OR (a.pdf_beta_ack->>'dispatchId'=a.pdf_dispatch_id::text
    AND a.pdf_beta_ack->'binding'=a.pdf_binding
    AND a.pdf_beta_ack->'response'->'status'='200'::jsonb
    AND a.pdf_beta_ack->'response'->'transportComplete'='true'::jsonb
    AND a.pdf_beta_ack->'response'->'upsert'='false'::jsonb),false))
) AS result;
ROLLBACK;
"""
M1_PDF_QUERY_SHA256 = hashlib.sha256(M1_PDF_SQL.encode()).hexdigest()


def validate_pdf_readback(proof, system_identifier, clock, writer_pid=None):
    need(isinstance(proof, dict) and set(proof) == {
         'sessionUser', 'currentUser', 'database', 'readOnly', 'systemIdentifier',
         'backendPid', 'clock', 'admissionClosed', 'unresolvedNonExempt'},
         'M1_PDF_READBACK_SHAPE_UNPROVED')
    need(proof['sessionUser'] == proof['currentUser'] == 'postgres'
         and proof['database'] == 'postgres' and proof['readOnly'] is True
         and proof['systemIdentifier'] == system_identifier
         and type(proof['backendPid']) is int and proof['backendPid'] > 0
         and proof['backendPid'] != writer_pid
         and type(proof['clock']) in (int, float) and 0 <= clock - proof['clock'] <= 15,
         'M1_PDF_READBACK_CONTEXT_UNPROVED')
    need(proof['admissionClosed'] is True, 'M1_PDF_NEW_DISPATCH_NOT_CLOSED')
    need(type(proof['unresolvedNonExempt']) is int and proof['unresolvedNonExempt'] == 0,
         'M1_NON_EXEMPT_PDF_DISPATCH_UNRESOLVED')
    return proof


class Refused(ValueError):
    pass

def need(condition,message):
    if not condition:
        raise Refused(message)

def result_value(reply):
    rows=reply['rows']
    need(len(rows)==1 and set(rows[0])=={'result'},'EXACT_OBSERVATION_RESULT_REQUIRED')
    value=rows[0]['result']
    return json.loads(value) if isinstance(value,str) else value

class LinkedPG:
    def __init__(self,request,sql,dispatch,assert_stopped_lease,clock=time.time):
        self.request=request
        self.sql=sql
        self.dispatch=dispatch
        self.assert_stopped_lease=assert_stopped_lease
        self.clock=clock
        self.dispatched={}
        ids=(request['executionId'],request['inverseExecutionId'])
        hashes=(request['effectiveSQLSHA256'],request['effectiveInverseSHA256'])
        need(request['project']==PROJECT and len(set(ids))==len(set(hashes))==2
             and all(re.fullmatch('[a-f0-9]{32}',i) for i in ids)
             and all(re.fullmatch('[a-f0-9]{64}',h) for h in hashes),'FIXED_PG_ENVELOPE_REQUIRED')
        self.identities=dict(zip(hashes,ids))

    def drain(self):
        self.assert_stopped_lease()
        r=result_value(self.sql(DRAIN_SQL))
        need(r['sessionUser']==r['currentUser']=='postgres' and 170000<=r['pgVersion']<180000
             and r['fullVisibility'] is True and 0<=self.clock()-float(r['clock'])<=5,
             'PG_DRAIN_CONTEXT_UNPROVED')
        self.assert_stopped_lease()
        return all(r[k]==0 for k in ('otherOpenClientTransactions','preparedTransactions','writerAdvisoryEntries','sourceScopes','providerScopes'))

    def send_once(self,frame):
        digest=hashlib.sha256(frame).hexdigest()
        key=self.identities.get(digest)
        need(key is not None and key not in self.dispatched,'SQL_HASH_OR_ONE_SHOT_DRIFT')
        cut=self.request['cutoff'] if key==self.request['executionId'] else self.request.get('inverseCutoff', self.request['D']-60)
        need(self.request['T']<=self.clock()<cut,'SQL_OUTSIDE_FIXED_CLOCK')
        need(self.drain(),'DRAIN_UNPROVED')
        need(self.clock()<cut,'SQL_CUTOFF_DURING_DRAIN')
        self.dispatched[key]='UNKNOWN'
        ack=self.dispatch(frame,key)
        need(ack=={'disposition':'ACKNOWLEDGED','executionId':key,'effectiveSQLSHA256':digest},
             'EXACT_MUTATION_ACK_UNPROVED')
        self.dispatched[key]='ACKNOWLEDGED'

    def terminated(self,key):
        if self.dispatched.get(key)!='ACKNOWLEDGED':
            return False
        self.assert_stopped_lease()
        tag='root2-p6-mutator-'+key
        q=("BEGIN READ ONLY;SET LOCAL statement_timeout='5s';"
           "SELECT jsonb_build_object('session',session_user,'principal',current_user,"
           "'visibility',pg_has_role(current_user,'pg_read_all_stats','USAGE'),"
           "'count',(SELECT count(*) FROM pg_stat_activity "
           "WHERE datname=current_database() AND application_name='"+tag+"')) AS result;ROLLBACK;")
        r=result_value(self.sql(q))
        self.assert_stopped_lease()
        return r=={'session':'postgres','principal':'postgres','visibility':True,'count':0}
