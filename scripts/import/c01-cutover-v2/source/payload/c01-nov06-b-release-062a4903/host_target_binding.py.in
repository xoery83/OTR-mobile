"""Exact Docker config projection used to stage an exact closed target."""
import copy
import http.client
import json
import re
import socket

BASELINE = '@BASELINE_IMAGE_ID@'
TARGET = '@LEGACY_TARGET_IMAGE_ID@'
CONTINUOUS_HOST = 'OTR_DEV_UNIVERSAL_CONTINUOUS_HOST'
RUNTIME_HASH = 'OTR_DEV_UNIVERSAL_RUNTIME_SHA256'
RUNTIME_DEST = '/run/otr/universal-runtime.json'

def target_payload(baseline, target=TARGET, *, disable_continuous=False):
    if baseline['Image'] != BASELINE:
        raise ValueError('WRONG_RETAINED_IMAGE')
    config = copy.deepcopy(baseline['Config'])
    config['Image'] = target
    if disable_continuous:
        env = config['Env']
        matches = [i for i, entry in enumerate(env) if entry.partition('=')[0] == CONTINUOUS_HOST]
        if len(matches) != 1 or env[matches[0]] != CONTINUOUS_HOST + '=enabled':
            raise ValueError('M1_CONTINUOUS_SELECTOR_PREIMAGE_DRIFT')
        env[matches[0]] = CONTINUOUS_HOST + '=disabled'
    return {**config,'HostConfig':copy.deepcopy(baseline['HostConfig'])}

def legacy_recovery_projection(baseline, pins):
    config = target_payload(baseline, BASELINE, disable_continuous=True)
    host = config['HostConfig']
    old, new = pins['sharedSource'], pins['dedicatedSource']
    binds = host.get('Binds') or []
    matches = [i for i, bind in enumerate(binds) if bind.split(':')[1:2] == [RUNTIME_DEST]]
    if (len(matches) != 1 or binds[matches[0]].split(':')[0] != old
            or any(mount.get('Target') == RUNTIME_DEST for mount in host.get('Mounts') or [])):
        raise ValueError('M1_RECOVERY_BIND_PREIMAGE_DRIFT')
    index = matches[0]
    binds[index] = new + binds[index][len(old):]
    env = config['Env']
    matches = [i for i, entry in enumerate(env) if entry.partition('=')[0] == RUNTIME_HASH]
    if len(matches) != 1 or env[matches[0]] != RUNTIME_HASH + '=' + pins['sharedSHA256']:
        raise ValueError('M1_RECOVERY_RUNTIME_HASH_PREIMAGE_DRIFT')
    env[matches[0]] = RUNTIME_HASH + '=' + pins['dedicatedSHA256']
    mounts = mount_projection(baseline)
    actual = [m for m in mounts if m[1] == RUNTIME_DEST]
    if len(actual) != 1 or actual[0][:4] != (old, RUNTIME_DEST, False, 'bind'):
        raise ValueError('M1_RECOVERY_MOUNT_PREIMAGE_DRIFT')
    mounts = [(new, *m[1:]) if m[1] == RUNTIME_DEST else m for m in mounts]
    return config, mounts


def mount_projection(row):
    fields = ('Source', 'Destination', 'RW', 'Type', 'Propagation')
    return sorted((tuple(m.get(k) for k in fields) for m in row['Mounts']), key=lambda m: m[1])


def m1_create_host_config(host):
    # Docker materializes an explicit null as false when creating a container.
    if host.get('OomKillDisable', False) is None:
        return {**host, 'OomKillDisable': False}
    return host


def create_exact_target(path,name,baseline,target=TARGET, *, disable_continuous=False):
    payload = target_payload(baseline,target,disable_continuous=disable_continuous)
    if disable_continuous:
        payload['HostConfig'] = m1_create_host_config(payload['HostConfig'])
    return create_from_payload(path, name, payload)


def create_from_payload(path, name, payload):
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{1,90}',name):
        raise ValueError('INVALID_OWNED_TARGET_NAME')
    class UnixDocker(http.client.HTTPConnection):
        def connect(self):
            self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
            self.sock.settimeout(15)
            self.sock.connect(path)
    with_connection=UnixDocker('localhost',timeout=15)
    try:
        with_connection.request('POST','/v1.47/containers/create?name='+name,
                                body=json.dumps(payload).encode(),
                                headers={'Content-Type':'application/json'})
        response=with_connection.getresponse()
        body=response.read(131072)
        if response.status!=201:
            raise RuntimeError('CREATE_UNCONFIRMED_READ_ONLY_LOOKUP_REQUIRED')
        cid=json.loads(body)['Id']
        if not re.fullmatch('[0-9a-f]{64}',cid):
            raise ValueError('TARGET_CID_UNCONFIRMED')
        return cid
    finally:
        with_connection.close()

def verify_target(baseline,candidate,cid,target=TARGET, *, disable_continuous=False):
    expected=target_payload(baseline,target,disable_continuous=disable_continuous)
    host_config=expected.pop('HostConfig')
    if disable_continuous:
        host_config = m1_create_host_config(host_config)
    if (candidate['Id'],candidate['Image'],candidate['Config'],candidate['HostConfig']) != (cid,target,expected,host_config):
        raise ValueError('TARGET_CONFIG_DRIFT')
    fields=('Source','Destination','RW','Type','Propagation')
    if sorted(tuple(m.get(k) for k in fields) for m in baseline['Mounts']) != sorted(tuple(m.get(k) for k in fields) for m in candidate['Mounts']):
        raise ValueError('TARGET_MOUNT_DRIFT')
