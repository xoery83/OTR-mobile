+  expect(await repository.readPrivate(f.scope)).toEqual(f.snapshot);
+  expect((await repository.local?.read(f.scope))?.accepted).toEqual(f.snapshot);
+  expect(repository.local).not.toHaveProperty("cacheServer");
+});
