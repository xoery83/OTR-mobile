    {
      "definition": "CREATE OR REPLACE FUNCTION public.assert_trip_core_v2_aggregate(item uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$ declare root public.itinerary_events;endpoint_count integer;service_count integer;begin\n select * into root from public.itinerary_events where id=item;\n if not found then return;end if;\n if root.business_contract_version is null then perform public.assert_trip_event_aggregate(item);return;end if;\n if not public.trip_core_event_row_valid(to_jsonb(root)) then raise exception 'CORE_V2_INVALID_AGGREGATE' using errcode='23514';end if;\n select count(*) into endpoint_count from public.itinerary_transport_endpoints where event_id=item;\n select count(*) into service_count from public.itinerary_transport_services where event_id=item;\n if root.temporal_shape='TRANSPORT' then\n  if endpoint_count<>2 or not exists(select 1 from public.itinerary_transport_endpoints where event_id=item and role='ORIGIN' and local_date is not null) then raise exception 'CORE_V2_INVALID_ENDPOINTS' using errcode='23514';end if;\n  if root.experience_family='P2' AND (session_user='otr_trip_core_v2_gateway'\n   AND coalesce(current_setting('otr.core.command',true),'') IN ('SET_AUTHORED_FLIGHT_DETAILS','SET_ITEM_PARTICIPATION')\n   AND current_setting('otr.core.family',true) IS NOT DISTINCT FROM 'P2'\n   AND current_setting('otr.core.admission',true) IS NOT DISTINCT FROM 'MANUAL'\n   AND current_setting('otr.core.target_item',true) IS NOT DISTINCT FROM item::text\n   AND root.owner_account_id IS NOT DISTINCT FROM nullif(current_setting('otr.core.actor',true),'')::uuid\n   AND public.trip_sustained_dev_scope_allowed(root.owner_account_id,root.trip_id,null,'CORE_P2_DETAILS')) IS TRUE then\n   if service_count<>0 OR NOT EXISTS(SELECT 1 FROM public.trip_flight_intents WHERE event_id=item AND trip_id=root.trip_id AND qualification='SPARSE')\n    OR EXISTS(SELECT 1 FROM public.itinerary_transport_endpoints ep WHERE ep.event_id=item AND (ep.instant IS NOT NULL OR ep.source_instant IS NOT NULL OR ep.source_instant_precision IS NOT NULL OR ep.interpretation_key IS NOT NULL OR ep.interpretation_input_sha256 IS NOT NULL OR ep.provenance_refs IS NOT NULL OR ep.civil_resolution IS DISTINCT FROM 'PENDING' OR ep.basis IS DISTINCT FROM 'DERIVED_CIVIL' OR ep.resolution_offset_seconds IS NOT NULL OR ep.supplied_offset_seconds IS NOT NULL))\n   then raise exception 'CORE_V2_INVALID_AUTHORED_FLIGHT' using errcode='23514';end if;\n  else\n  if root.experience_family='P2' and (service_count not between 1 and 4 or exists(select 1 from public.itinerary_transport_services where event_id=item and transport_subtype<>'FLIGHT') or not exists(select 1 from public.trip_flight_intents where event_id=item and qualification='QUALIFIED')) then raise exception 'CORE_V2_INVALID_FLIGHT' using errcode='23514';end if;\n  end if;\n  if root.experience_family='P5' and (service_count<>1 or exists(select 1 from public.itinerary_transport_services where event_id=item and transport_subtype='FLIGHT')) then raise exception 'CORE_V2_INVALID_SEGMENT' using errcode='23514';end if;\n elsif endpoint_count<>0 or service_count<>0 then raise exception 'CORE_V2_DUPLICATE_SCHEDULE' using errcode='23514';end if;\n if root.experience_family='P2' and root.temporal_shape='CALENDAR' and not exists(select 1 from public.trip_flight_intents where event_id=item and qualification='SPARSE') then raise exception 'CORE_V2_INVALID_SPARSE_FLIGHT' using errcode='23514';end if;\n if root.participation_mode='SELECTED_MEMBERS' and not exists(select 1 from public.trip_item_participants where item_id=item and active) or root.participation_mode<>'SELECTED_MEMBERS' and exists(select 1 from public.trip_item_participants where item_id=item and active) then raise exception 'CORE_V2_INVALID_PARTICIPATION' using errcode='23514';end if;\n if root.visibility='SELECTED_PERSONS' and not exists(select 1 from public.trip_item_visibility_people where item_id=item) or root.visibility<>'SELECTED_PERSONS' and exists(select 1 from public.trip_item_visibility_people where item_id=item) then raise exception 'CORE_V2_INVALID_VISIBILITY' using errcode='23514';end if;\nend $function$\n",
      "name": "assert_trip_core_v2_aggregate"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.trip_core_boundary_valid(row_data jsonb, prefix text)\n RETURNS boolean\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'pg_catalog'\nAS $function$ declare d date; t time; p integer; q text; b text; n timestamptz; s timestamptz; sp integer;r text;off integer;z text;ik text;ih text;begin\n d:=(row_data->>(prefix||'local_date'))::date;t:=(row_data->>(prefix||'local_time'))::time;p:=(row_data->>(prefix||'clock_precision'))::integer;\n q:=row_data->>(prefix||'quality');b:=row_data->>(prefix||'basis');s:=(row_data->>(prefix||'source_instant'))::timestamptz;sp:=(row_data->>(prefix||'source_instant_precision'))::integer;\n r:=row_data->>(prefix||'civil_resolution');off:=(row_data->>(prefix||'resolution_offset_seconds'))::integer;z:=row_data->>(prefix||'zone_id');ik:=row_data->>(prefix||'interpretation_key');ih:=row_data->>(prefix||'interpretation_input_sha256');\n n:=(row_data->>case prefix when 'start_' then 'planned_start' when 'end_' then 'planned_end' else 'instant' end)::timestamptz;\n if d is not null and (not isfinite(d) or extract(year from d) not between 1 and 9999) or t is not null and t>=time '24:00' or n is not null and not isfinite(n) then return false;end if;\n if (t is null)<>(p is null) or p is not null and (p not between -1 and 6 or p=-1 and extract(second from t)<>0 or p>=0 and extract(epoch from t)<>trunc(extract(epoch from t),p)) then return false;end if;\n if (s is null)<>(sp is null) or sp is not null and (sp not between -1 and 6 or sp=-1 and extract(second from s at time zone 'UTC')<>0 or sp>=0 and extract(epoch from s)<>trunc(extract(epoch from s),sp)) then return false;end if;\n if n is not null then\n  if q<>'EXACT' or q is null then return false;end if;\n  if b='SOURCE_INSTANT' then return s is not null and n=s;end if;\n  return b='DERIVED_CIVIL' and d is not null and t is not null and z is not null and r in ('UNIQUE','FOLD_RESOLVED') and off is not null and ik is not null and ih ~ '^[0-9a-f]{64}$' and n=((d+t) at time zone 'UTC')-make_interval(secs=>off);\n end if;\n if s is not null or b='SOURCE_INSTANT' or off is not null or ik is not null or ih is not null or r is not null and r<>'PENDING' then return false;end if;\n if t is null then return (q='UNKNOWN' or q is null) and (b='DERIVED_CIVIL' or b is null);end if;\n return q='ESTIMATED' and b='DERIVED_CIVIL' and r='PENDING';\nexception when others then return false;end $function$\n",
      "name": "trip_core_boundary_valid"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.trip_core_event_row_valid(r jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'pg_catalog'\nAS $function$ declare family text:=r->>'experience_family';shape text:=r->>'temporal_shape';begin\n if r->>'business_contract_version'<>'2' or r->>'temporal_contract_version'<>'1' or r->>'owner_account_id' is null or r->>'visibility' not in ('PRIVATE','GROUP','SELECTED_PERSONS') or r->>'participation_mode' not in ('WHOLE_GROUP','SELECTED_MEMBERS','SELF') or r->>'participant_scope'<>(case when r->>'participation_mode'='WHOLE_GROUP' then 'WHOLE_GROUP' else 'ASSIGNED' end) or jsonb_typeof(r->'field_state')<>'object' or r->>'semantic_revision' is null then return false;end if;\n if family not in ('P1','P2','P3','P4','P5','P6') or shape not in ('POINT','CALENDAR','ALL_DAY','SPAN','STAY','TRANSPORT','WINDOW') then return false;end if;\n if family='P3' and (shape<>'STAY' or r->>'end_local_date' is null) or family='P5' and shape<>'TRANSPORT' or family='P2' and shape not in ('CALENDAR','TRANSPORT') or family in ('P1','P4','P6') and shape in ('STAY','TRANSPORT') then return false;end if;\n if shape='TRANSPORT' then return r->>'start_local_date' is null and r->>'end_local_date' is null and r->>'planned_start' is null and r->>'planned_end' is null;end if;\n return r->>'start_local_date' is not null and public.trip_core_boundary_valid(r,'start_') and public.trip_core_boundary_valid(r,'end_') and (r->>'end_local_date' is null or (r->>'end_local_date')::date >=(r->>'start_local_date')::date) and (r->>'planned_start' is null or r->>'planned_end' is null or (r->>'planned_end')::timestamptz >= (r->>'planned_start')::timestamptz);\nexception when others then return false;end $function$\n",
      "name": "trip_core_event_row_valid"
    }
  ]
