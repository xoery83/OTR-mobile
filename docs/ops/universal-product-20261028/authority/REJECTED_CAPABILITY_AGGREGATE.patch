--- a/backend/src/tripCoreV2PgRead.test.ts
+++ b/backend/src/tripCoreV2PgRead.test.ts
@@ -266,3 +266,53 @@ it.each(["P2", "P3", "P4", "P5", "P6"] as const)(
     expect(c.sourceEvidenceAvailable).toBe(true);
   },
 );
+
+it.each([["P1", "P2", "P3", "P4", "P5", "P6"], ["P1", "P6"], []])(
+  "reads continuous reviewed capabilities with owning family context: %j",
+  async ({ permitted }) => {
+    const f = fixture();
+    f.actor.personId = randomUUID();
+    let requested = "";
+    const base = f.lease.query.getMockImplementation()!;
+    const query = vi.fn(async (sql: string, values?: readonly unknown[]) => {
+      if (sql.includes("set_config('otr.universal.requested_family'")) {
+        requested = String(values?.[0] ?? "");
+        return { rows: [] };
+      }
+      if (sql.includes("trip_sustained_import_p1_capabilities"))
+        return {
+          rows: [
+            {
+              runtime_enabled: permitted.includes(requested),
+              enabled_commands: permitted.includes(requested)
+                ? [requested === "P2" ? "CREATE_SPARSE_FLIGHT" : "CREATE_ITEM"]
+                : [],
+              enabled_families: permitted.includes(requested) ? [requested] : [],
+              enabled_admission_modes: permitted.includes(requested)
+                ? ["REVIEWED_SOURCE"]
+                : [],
+            },
+          ],
+        };
+      return base(sql);
+    });
+    const reader = createCorePgReader(
+      { withLease: (work) => work({ ...f.lease, query } as never) },
+      async (value) => createHash("sha256").update(value).digest("hex"),
+      undefined,
+      { sustainedDev: true, reviewedP1: true },
+    );
+    const c = await reader.capabilities(f.actor.accountId, f.actor.tripId);
+    expect(c.sourceEvidenceAvailable).toBe(permitted.length > 0);
+    if (permitted.length) {
+      expect(c.enabledFamilies).toEqual(permitted);
+      expect(c.enabledCommands).toEqual(
+        permitted.includes("P2")
+          ? ["CREATE_ITEM", "CREATE_SPARSE_FLIGHT"]
+          : ["CREATE_ITEM"],
+      );
+      expect(c.enabledAdmissionModes).toEqual(["REVIEWED_SOURCE"]);
+    }
+    expect(requested).toBe("");
+  },
+);
