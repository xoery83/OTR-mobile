diff --git a/backend/src/tripCoreVersionCoRead.real.test.ts b/backend/src/tripCoreVersionCoRead.real.test.ts
new file mode 100644
index 00000000..99178b5a
--- /dev/null
+++ b/backend/src/tripCoreVersionCoRead.real.test.ts
@@ -0,0 +1,182 @@
+import { createHash, randomUUID } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import { checkServerIdentity } from "node:tls";
+import { Client } from "pg";
+import { beforeAll, afterAll, expect, it } from "vitest";
+
+// Existing owned loopback fixture only; never Hosted DEV or a caller-provided remote URL.
+const path = process.env.OTR_CORE_REUSE_LOCAL_FIXTURE;
+const test = path ? it : it.skip;
+let admin: Client, db: Client, database: string;
+const marker = randomUUID();
+const actor = randomUUID(),
+  trip = randomUUID(),
+  person = randomUUID(),
+  epoch = randomUUID();
+const sql =
+  "SELECT epoch,revision::float8 AS revision,access_revision::float8 AS access_revision,public.trip_core_read_person_bindings($2::uuid,$1::uuid) AS bindings FROM public.trip_core_read_state WHERE trip_id=$1::uuid";
+beforeAll(async () => {
+  if (!path) return;
+  const f = JSON.parse(readFileSync(path, "utf8"));
+  if (
+    f.host !== "127.0.0.1" ||
+    !/^otr_core_reuse_[a-f0-9]{8}$/.test(f.database) ||
+    !/^[a-f0-9]{32}$/.test(f.marker)
+  )
+    throw Error("NOT_OWN_LOOPBACK_FIXTURE");
+  const options = {
+    host: f.host,
+    port: f.port,
+    user: "postgres",
+    password: f.password,
+    connectionTimeoutMillis: 3000,
+    ssl: {
+      ca: f.ca,
+      rejectUnauthorized: true,
+      checkServerIdentity: (_: string, cert: Parameters<typeof checkServerIdentity>[1]) =>
+        checkServerIdentity(f.host, cert),
+    },
+  };
+  admin = new Client({ ...options, database: f.database });
+  await admin.connect();
+  expect((await admin.query("SELECT value FROM fixture_marker")).rows).toEqual([
+    { value: f.marker },
+  ]);
+  database = `otr_coread_${randomUUID().replaceAll("-", "")}`;
+  await admin.query(`CREATE DATABASE "${database}"`);
+  db = new Client({ ...options, database });
+  await db.connect();
+  await db.query("CREATE TABLE own_fixture_marker(value text)");
+  await db.query("INSERT INTO own_fixture_marker VALUES($1)", [marker]);
+  await db.query(`CREATE TABLE trips(id uuid,created_by uuid); CREATE TABLE trip_members(trip_id uuid,user_id uuid);
+    CREATE TABLE journey_members(id uuid,trip_id uuid,user_id uuid,status text,participation_active boolean,participation_revision int);
+    CREATE TABLE trip_core_read_state(trip_id uuid,epoch uuid,revision bigint,access_revision bigint);`);
+  for (const file of [
+    "20261011000300_trip_core_v2_owning_session.sql",
+    "20261011000400_trip_core_v2_read_scope.sql",
+  ]) {
+    const source = readFileSync(
+      new URL(`../../supabase/migrations/${file}`, import.meta.url),
+      "utf8",
+    );
+    await db.query(
+      source.slice(source.indexOf("create function"), source.indexOf("revoke all")),
+    );
+  }
+  const definitions = (
+    await db.query(
+      "SELECT proname,pg_get_functiondef(oid) AS definition,provolatile,prosecdef,proconfig FROM pg_proc WHERE oid IN ('public.trip_core_lock_actor_scope(uuid,uuid)'::regprocedure,'public.trip_core_read_person_bindings(uuid,uuid)'::regprocedure) ORDER BY proname",
+    )
+  ).rows;
+  if (process.env.OTR_COREAD_FUNCTION_RECEIPT)
+    writeFileSync(
+      process.env.OTR_COREAD_FUNCTION_RECEIPT,
+      JSON.stringify(
+        definitions.map((r) => ({
+          ...r,
+          sha256: createHash("sha256").update(r.definition).digest("hex"),
+        })),
+        null,
+        2,
+      ),
+    );
+  expect(definitions.every((r) => r.provolatile === "v" && r.prosecdef === true)).toBe(
+    true,
+  );
+  await db.query("INSERT INTO trips VALUES($1,$2);", [trip, actor]);
+  await db.query("INSERT INTO journey_members VALUES($1,$2,$3,'linked',true,7)", [
+    person,
+    trip,
+    actor,
+  ]);
+  await db.query("INSERT INTO trip_core_read_state VALUES($1,$2,4,5)", [trip, epoch]);
+  // Fixture-only invocation counter proves a zero-row FROM does not invoke the VOLATILE function.
+  await db.query("CREATE SEQUENCE binding_calls");
+  const binding = definitions.find(
+    (r) => r.proname === "trip_core_read_person_bindings",
+  )!.definition;
+  const instrumented = binding.replace(
+    "begin\n",
+    "begin\n PERFORM nextval('public.binding_calls');\n",
+  );
+  expect(instrumented).not.toBe(binding);
+  await db.query(instrumented);
+  await db.query(
+    "GRANT SELECT ON trip_core_read_state TO otr_trip_core_v2_gateway; GRANT EXECUTE ON FUNCTION trip_core_read_person_bindings(uuid,uuid),trip_core_lock_actor_scope(uuid,uuid) TO otr_trip_core_v2_gateway",
+  );
+});
+afterAll(async () => {
+  if (db) {
+    expect((await db.query("SELECT value FROM own_fixture_marker")).rows).toEqual([
+      { value: marker },
+    ]);
+    await db.end();
+  }
+  if (admin) {
+    if (database && /^otr_coread_[a-f0-9]{32}$/.test(database))
+      await admin.query(`DROP DATABASE "${database}" WITH (FORCE)`);
+    await admin.end();
+  }
+});
+async function asActor<T>(work: () => Promise<T>) {
+  await db.query("SET SESSION AUTHORIZATION otr_trip_core_v2_gateway");
+  try {
+    await db.query("BEGIN ISOLATION LEVEL REPEATABLE READ");
+    await db.query(
+      "SELECT set_config('otr.core.actor',$1,true),set_config('otr.core.trip',$2,true)",
+      [actor, trip],
+    );
+    const result = await work();
+    await db.query("COMMIT");
+    return result;
+  } catch (error) {
+    await db.query("ROLLBACK");
+    throw error;
+  } finally {
+    await db.query("RESET SESSION AUTHORIZATION");
+  }
+}
+test("actual SQL co-read equals separate state/bindings under the same prior actor lock", async () => {
+  await asActor(async () => {
+    await db.query("SELECT public.trip_core_lock_actor_scope($1,$2)", [actor, trip]);
+    const state = (
+      await db.query(
+        "SELECT epoch,revision::float8 AS revision,access_revision::float8 AS access_revision FROM trip_core_read_state WHERE trip_id=$1",
+        [trip],
+      )
+    ).rows[0];
+    const bindings = (
+      await db.query("SELECT public.trip_core_read_person_bindings($1,$2) AS bindings", [
+        actor,
+        trip,
+      ])
+    ).rows[0].bindings;
+    const combined = (await db.query(sql, [trip, actor])).rows[0];
+    expect(combined).toEqual({ ...state, bindings });
+    expect(bindings).toEqual([
+      {
+        person_id: person,
+        account_id: actor,
+        active: true,
+        participating: true,
+        revision: 7,
+      },
+    ]);
+  });
+  expect(
+    (await db.query("SELECT last_value,is_called FROM binding_calls")).rows[0],
+  ).toEqual({ last_value: "2", is_called: true });
+});
+test("actual SQL missing state does not invoke bindings and mismatched Actor still rejects", async () => {
+  const before = (await db.query("SELECT last_value,is_called FROM binding_calls"))
+    .rows[0];
+  await asActor(async () => {
+    expect((await db.query(sql, [randomUUID(), actor])).rows).toEqual([]);
+  });
+  expect(
+    (await db.query("SELECT last_value,is_called FROM binding_calls")).rows[0],
+  ).toEqual(before);
+  await expect(asActor(() => db.query(sql, [trip, randomUUID()]))).rejects.toThrow(
+    "CORE_SCOPE_MISMATCH",
+  );
+});
