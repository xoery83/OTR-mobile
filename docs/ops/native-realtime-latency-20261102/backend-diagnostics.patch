+  const ticks = [0, 5, 5, 18, 18, 47, 47, 88];
+  const clock = vi
+    .spyOn(performance, "now")
+    .mockImplementation(() => ticks.shift() ?? 88);
+  const phases: [string, number][] = [];
+  const observations: { phase: string; queries: string[]; releases: boolean[] }[] = [];
+  try {
+    await createCorePgConnection(config).withLease(
+      async (lease) => {
+        await lease.query("BEGIN");
+        await lease.query("COMMIT");
+      },
+      (phase, duration) => {
+        phases.push([phase, duration]);
+        observations.push({ phase, queries: [...f.queries], releases: [...f.releases] });
+      },
+    );
+    expect(phases).toEqual([
+      ["queueMs", 5],
+      ["physicalAcquireMs", 13],
+      ["principalCheckMs", 29],
+      ["cleanupMs", 41],
+    ]);
+    expect(observations.find((o) => o.phase === "physicalAcquireMs")?.queries).toEqual(
+      [],
+    );
+    expect(
+      observations.find((o) => o.phase === "principalCheckMs")?.queries.at(-1),
+    ).toContain("pg_is_in_recovery");
+    expect(observations.find((o) => o.phase === "cleanupMs")).toMatchObject({
+      releases: [false],
+    });
+    expect(observations.find((o) => o.phase === "cleanupMs")?.queries.at(-1)).toBe(
+      "DISCARD ALL",
+    );
+    expect(f.queries.slice(1)).toEqual(["BEGIN", "COMMIT", "DISCARD ALL"]);
+  } finally {
+    clock.mockRestore();
+  }
+});
+it("a rejected diagnostic callback cannot change committed results or warm principal rejection", async () => {
+  const connection = createCorePgConnection(config);
+  const timing = () => {
+    throw new Error("diagnostic unavailable");
+  };
+  const result = await connection.withLease(async (lease) => {
+    await lease.query("BEGIN");
+    await lease.query("COMMIT");
+    return "committed";
+  }, timing);
+  expect(result).toBe("committed");
+  f.loginUnexpired = false;
+  const work = vi.fn();
+  await expect(connection.withLease(work, timing)).rejects.toThrow(
+    "CORE_PRINCIPAL_UNAVAILABLE",
+  );
+  expect(work).not.toHaveBeenCalled();
+  expect(f.releases).toEqual([false, true]);
+});
