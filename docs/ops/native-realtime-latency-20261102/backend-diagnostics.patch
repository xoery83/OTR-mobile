diff --git a/backend/src/tripAuthorizedVersionDiagnostics.test.ts b/backend/src/tripAuthorizedVersionDiagnostics.test.ts
new file mode 100644
index 00000000..aab1d09b
--- /dev/null
+++ b/backend/src/tripAuthorizedVersionDiagnostics.test.ts
@@ -0,0 +1,167 @@
+import { createHash, randomUUID } from "node:crypto";
+import { afterEach, expect, it, vi } from "vitest";
+import { createDevBackendHandler, type DevBackendGateway } from "./app";
+import { createCorePgReader } from "./tripCoreV2PgRead";
+import type { CoreHttpConnection } from "./tripCoreV2Http";
+import type { CorePgConnection } from "./tripCoreV2PgStorage";
+
+const accountId = randomUUID(),
+  tripId = randomUUID(),
+  epoch = randomUUID();
+afterEach(() => vi.restoreAllMocks());
+function fixture(allowed = true) {
+  let time = 0;
+  vi.spyOn(performance, "now").mockImplementation(() => time);
+  const events: Record<string, unknown>[] = [];
+  vi.spyOn(console, "info").mockImplementation((value) => {
+    events.push(JSON.parse(String(value)));
+  });
+  const queries: string[] = [];
+  const connection: CorePgConnection = {
+    async withLease(work, timing) {
+      timing?.("queueMs", 2);
+      timing?.("physicalAcquireMs", 4);
+      timing?.("principalCheckMs", 6);
+      const result = await work({
+        retire() {},
+        async query(sql) {
+          time += 3;
+          queries.push(sql);
+          if (sql.includes("session_user"))
+            return {
+              rows: [
+                {
+                  principal: "otr_trip_core_v2_gateway",
+                  role: "otr_trip_core_v2_gateway",
+                },
+              ],
+            };
+          if (sql.includes("trip_core_finite_scope_allowed"))
+            return { rows: [{ allowed: true }] };
+          if (sql.includes("trip_core_lock_actor_scope"))
+            return {
+              rows: [
+                {
+                  actor: {
+                    accountId,
+                    tripId,
+                    active: true,
+                    canManageShared: false,
+                    personId: null,
+                    personIds: [],
+                  },
+                },
+              ],
+            };
+          if (sql.includes("trip_core_activation_gate"))
+            return { rows: [{ runtime_enabled: true }] };
+          if (sql.includes("trip_core_read_state"))
+            return { rows: [{ epoch, revision: 1, access_revision: 1 }] };
+          if (sql.includes("authored_version_projection"))
+            return { rows: [{ projection_kind: "blocked", fact: false }] };
+          if (sql.includes("trip_core_read_person_bindings"))
+            return { rows: [{ bindings: [] }] };
+          return { rows: [] };
+        },
+      });
+      time += 17; // Deterministic existing lease release/cleanup time, not a Hosted measurement.
+      timing?.("cleanupMs", 17);
+      return result;
+    },
+  };
+  const hash = async (bytes: Uint8Array) => {
+    time += 11;
+    return createHash("sha256").update(bytes).digest("hex");
+  };
+  const reader = createCorePgReader(connection, hash);
+  const authorizedVersion = vi.fn(reader.authorizedVersion);
+  const logs: Record<string, unknown>[] = [];
+  const gateway = {
+    async validateAccessToken() {
+      time += 5;
+      return { id: accountId, accountClass: "NORMAL_ACCOUNT" };
+    },
+    async canReadTrip() {
+      time += 7;
+      return allowed;
+    },
+  } as unknown as DevBackendGateway;
+  const handler = createDevBackendHandler({
+    gateway,
+    coreConnection: {
+      read: { ...reader, authorizedVersion },
+      hash,
+    } as unknown as CoreHttpConnection,
+    now: () => time,
+    log: (value) => {
+      logs.push(value);
+    },
+  });
+  const request = () =>
+    new Request(`http://local/v2/trips/${tripId}/core/authorized-version`, {
+      headers: {
+        Authorization: "Bearer synthetic-secret-not-for-logs",
+        "X-Request-Id": "untrusted-client-id",
+      },
+    });
+  return { handler, request, events, logs, queries, authorizedVersion };
+}
+it("correlates only server request ID across HTTP/Reader and includes existing lease cleanup without sensitive values", async () => {
+  const f = fixture(),
+    response = await f.handler(f.request());
+  expect(response.status).toBe(200);
+  const body = await response.json(),
+    requestId = response.headers.get("X-Request-Id");
+  expect(requestId).toMatch(/^[a-f0-9-]{36}$/);
+  expect(f.authorizedVersion).toHaveBeenCalledWith(
+    accountId,
+    tripId,
+    undefined,
+    requestId,
+  );
+  expect(f.logs[0]).toMatchObject({
+    requestId,
+    coreVersionAuthMs: 5,
+    coreVersionTripVisibilityMs: 7,
+  });
+  expect(f.events).toHaveLength(2);
+  expect(f.events.every((e) => e.requestId === requestId)).toBe(true);
+  expect(f.events[0]).toMatchObject({
+    event: "core_authorized_version_projection",
+    leaseReleaseMs: 17,
+    leasePhases: { queueMs: 2, physicalAcquireMs: 4, principalCheckMs: 6, cleanupMs: 17 },
+    projectionPhases: {
+      writerRoleMs: 3,
+      projectionSqlMs: 3,
+      gatewayRoleMs: 3,
+      bindingsMs: 3,
+    },
+  });
+  expect(f.events[0].totalMs).toBeGreaterThan(Number(f.events[0].beforeProjectionMs));
+  const logText = JSON.stringify([f.events, f.logs]);
+  for (const secret of [
+    accountId,
+    tripId,
+    body.token,
+    "synthetic-secret",
+    "untrusted-client-id",
+    "SELECT",
+    "Bearer",
+  ])
+    expect(logText).not.toContain(secret);
+  expect(f.queries[0]).toBe("BEGIN ISOLATION LEVEL REPEATABLE READ");
+  expect(f.queries.at(-1)).toBe("COMMIT");
+});
+it("denied Trip never enters Reader and diagnostic logger failures cannot change a valid response", async () => {
+  const denied = fixture(false),
+    response = await denied.handler(denied.request());
+  expect(response.status).toBe(404);
+  expect(denied.authorizedVersion).not.toHaveBeenCalled();
+  expect(denied.queries).toEqual([]);
+  expect(denied.events).toEqual([]);
+  const f = fixture();
+  vi.mocked(console.info).mockImplementation(() => {
+    throw new Error("logger unavailable");
+  });
+  expect((await f.handler(f.request())).status).toBe(200);
+});
