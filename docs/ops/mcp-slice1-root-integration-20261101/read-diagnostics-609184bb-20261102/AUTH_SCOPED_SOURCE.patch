+    .mockImplementation((ports) => {
+      diagnostic = ports!.readDiagnostic!;
+      return original(ports);
+    });
+  try {
+    await loadMcpQaRuntime(q.env, q.gateway, q.core, q.files);
+    const { bindBackend } = q.createReadRuntime.mock.calls[0][0] as {
