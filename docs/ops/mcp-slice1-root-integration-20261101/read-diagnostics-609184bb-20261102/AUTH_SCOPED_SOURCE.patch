+  const info = vi.spyOn(console, "info").mockImplementation(() => {});
+  const original = readBindings.createMcpAccountReadBinding;
+  let diagnostic!: (event: readBindings.McpReadStageDiagnostic) => void;
+  const bindSpy = vi
