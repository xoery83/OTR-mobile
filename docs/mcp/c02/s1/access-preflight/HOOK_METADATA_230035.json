  "sql": "-- MCP C02 read-only metadata; no credential or business rows.\nselect clock_timestamp() as observed_at,\n (select jsonb_build_object('owner',pg_catalog.pg_get_userbyid(p.proowner),'securityDefiner',p.prosecdef,'config',p.proconfig,'acl',p.proacl::text,'bodyMD5',md5(p.prosrc)) from pg_catalog.pg_proc p where p.oid=to_regprocedure('public.otr_mcp_qa_access_token(jsonb)')) as hook,\n (select jsonb_agg(jsonb_build_object('table',table_name,'column',column_name,'type',data_type) order by table_name,ordinal_position) from information_schema.columns where table_schema='auth' and table_name in ('oauth_clients','oauth_authorizations','oauth_consents')) as oauth_schema;",
